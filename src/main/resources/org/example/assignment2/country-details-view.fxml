<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.assignment2.CountryDetailsController" stylesheets="@styles.css" spacing="20" alignment="CENTER">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="headerLabel" styleClass="header-label" alignment="CENTER"/>
    <HBox spacing="40.0" alignment="CENTER">
        <VBox alignment="TOP_LEFT" spacing="15.0">
            <Label fx:id="capitalLabel" styleClass="label"/>
            <Label fx:id="populationLabel" styleClass="label"/>
            <Label fx:id="regionLabel" styleClass="label"/>
            <Label fx:id="subregionLabel" styleClass="label"/>
            <Label fx:id="areaLabel" styleClass="label"/>
            <Label fx:id="languagesLabel" styleClass="label"/>
            <Label fx:id="currencyLabel" styleClass="label"/>
            <Label fx:id="timezoneLabel" styleClass="label"/>
            <Label fx:id="callingCodeLabel" styleClass="label"/>
        </VBox>
        <ImageView fx:id="flagImageView" fitHeight="300" fitWidth="450" styleClass="image-view"/>
    </HBox>
    <Button fx:id="backButton" text="Back to Search" styleClass="button"/>
</VBox>