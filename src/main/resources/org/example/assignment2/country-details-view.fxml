<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.assignment2.CountryDetailsController" stylesheets="@styles.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="headerLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <HBox spacing="20.0">
        <VBox alignment="TOP_LEFT" spacing="10.0">
            <Label fx:id="capitalLabel"/>
            <Label fx:id="populationLabel"/>
            <Label fx:id="regionLabel"/>
            <Label fx:id="subregionLabel"/>
            <Label fx:id="areaLabel"/>
            <Label fx:id="languagesLabel"/>
            <Label fx:id="currencyLabel"/>
            <Label fx:id="timezoneLabel"/>
            <Label fx:id="callingCodeLabel"/>
        </VBox>
        <ImageView fx:id="flagImageView" fitHeight="200" fitWidth="300"/>
    </HBox>
    <Button fx:id="backButton" text="Back to Search"/>
</VBox>