<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.assignment2.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TextField fx:id="searchField" promptText="Enter country name"/>
    <Button fx:id="searchButton" text="Search"/>
    <Label fx:id="nameLabel"/>
    <Label fx:id="capitalLabel"/>
    <Label fx:id="populationLabel"/>
    <Label fx:id="regionLabel"/>
    <Label fx:id="subregionLabel"/>
</VBox>