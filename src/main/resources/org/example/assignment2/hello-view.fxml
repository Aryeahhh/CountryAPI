<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.assignment2.HelloController" alignment="CENTER" spacing="20" stylesheets="@styles.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TextField fx:id="searchField" styleClass="search-field"/>
    <ListView fx:id="suggestionsList" visible="false"/>
    <Button fx:id="searchButton" text="Search" styleClass="button"/>
</VBox>
